module

public import Ak3OrbitSeparation
public import AcBS23BrittonOracle
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Lemmas
public import Mathlib.GroupTheory.HNNExtension
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.GroupTheory.SpecificGroups.Cyclic

@[expose] public section

/-!
# AcBS23HNN — the HNN model of BS(2,3)

The group

```text
BS(2,3) = ⟨a, t | t a² t⁻¹ = a³⟩
```

is the HNN extension of `Multiplicative ℤ` by the subgroups generated by `2` and
`3`. This file builds the infinite cyclic equivalence and the HNN type. The
isomorphism from the presented group and the conjugacy reduction are separate
steps.
-/

set_option autoImplicit false

namespace AC
namespace BS23HNN

open Ak3OrbitSeparation

/-- The infinite cyclic base group. -/
abbrev Base : Type := Multiplicative ℤ

/-- The subgroup generated by `2` in the base group. -/
def A : Subgroup Base :=
  Subgroup.zpowers (Multiplicative.ofAdd (2 : ℤ))

/-- The subgroup generated by `3` in the base group. -/
def B : Subgroup Base :=
  Subgroup.zpowers (Multiplicative.ofAdd (3 : ℤ))

/-- An infinite cyclic subgroup is isomorphic to the integers. -/
noncomputable def zpowEquivSubgroup {G : Type*} [Group G] (g : G)
    (hg : orderOf g = 0) : Multiplicative ℤ ≃* Subgroup.zpowers g := by
  let f : Multiplicative ℤ →* Subgroup.zpowers g :=
    MonoidHom.codRestrict (zpowersHom G g) (Subgroup.zpowers g) (by
      intro x
      rw [← Subgroup.range_zpowersHom]
      exact ⟨x, rfl⟩)
  refine MulEquiv.ofBijective f ⟨?_, ?_⟩
  · intro x y hxy
    have hxy' : zpowersHom G g x = zpowersHom G g y := by
      simpa [f] using congrArg Subtype.val hxy
    have hker : (zpowersHom G g).ker = ⊥ := by
      rw [zpowersHom_ker_eq, hg]
      simp
    exact (MonoidHom.ker_eq_bot_iff (zpowersHom G g)).mp hker hxy'
  · intro y
    rcases y with ⟨y, hy⟩
    rw [← Subgroup.range_zpowersHom] at hy
    rcases hy with ⟨x, rfl⟩
    exact ⟨x, rfl⟩

/-- The infinite cyclic equivalence sends `ofAdd n` to `g ^ n`. -/
@[simp] theorem zpowEquivSubgroup_apply {G : Type*} [Group G] (g : G)
    (hg : orderOf g = 0) (n : ℤ) :
    (zpowEquivSubgroup g hg (Multiplicative.ofAdd n) : G) = g ^ n := by
  simp [zpowEquivSubgroup, MulEquiv.ofBijective_apply, MonoidHom.codRestrict, zpowersHom_apply]

/-- The inverse cyclic equivalence sends `g ^ n` to `ofAdd n`. -/
@[simp] theorem zpowEquivSubgroup_symm_apply {G : Type*} [Group G] (g : G)
    (hg : orderOf g = 0) (n : ℤ) :
    (zpowEquivSubgroup g hg).symm
      ⟨g ^ n, Subgroup.zpow_mem_zpowers g n⟩ = Multiplicative.ofAdd n := by
  apply (zpowEquivSubgroup g hg).injective
  apply Subtype.ext
  simp

/-- The generator `2` has infinite order. -/
theorem orderOf_two : orderOf (Multiplicative.ofAdd (2 : ℤ)) = 0 := by
  rw [orderOf_ofAdd_eq_addOrderOf]
  exact addOrderOf_eq_zero (by
    simp [isOfFinAddOrder_iff_nsmul_eq_zero])

/-- The generator `3` has infinite order. -/
theorem orderOf_three : orderOf (Multiplicative.ofAdd (3 : ℤ)) = 0 := by
  rw [orderOf_ofAdd_eq_addOrderOf]
  exact addOrderOf_eq_zero (by
    simp [isOfFinAddOrder_iff_nsmul_eq_zero])

/-- The HNN identifying `2` with `3`. -/
noncomputable def phi : A ≃* B :=
  (zpowEquivSubgroup (Multiplicative.ofAdd (2 : ℤ)) orderOf_two).symm.trans
    (zpowEquivSubgroup (Multiplicative.ofAdd (3 : ℤ)) orderOf_three)


/-- The HNN extension model of `BS(2,3)`. -/
abbrev HNN : Type :=
  HNNExtension Base A B phi

/-- The generator `2` as an element of `A`. -/
def hnnA : A :=
  ⟨Multiplicative.ofAdd (2 : ℤ), by
    rw [A]
    exact Subgroup.mem_zpowers _⟩

/-- The stable generator of the HNN model. -/
noncomputable def hnnGen : HNN :=
  HNNExtension.of (Multiplicative.ofAdd (1 : ℤ))

/-- The stable generator powers are the group-ring integer powers. -/
@[simp] theorem hnnGen_pow (n : ℕ) :
    hnnGen ^ n = HNNExtension.of (Multiplicative.ofAdd (n : ℤ)) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [pow_succ, ih, hnnGen, ← map_mul]
      congr 1

/-- The HNN relation `t a² t⁻¹ = a³`. -/
theorem hnn_conj :
    HNNExtension.t * hnnGen ^ 2 * HNNExtension.t⁻¹ = hnnGen ^ 3 := by
  have h := HNNExtension.equiv_eq_conj (φ := phi) hnnA
  have h2 : (zpowEquivSubgroup (Multiplicative.ofAdd (2 : ℤ)) orderOf_two).symm
      hnnA = Multiplicative.ofAdd (1 : ℤ) := by
    rw [show hnnA = ⟨(Multiplicative.ofAdd (2 : ℤ)) ^ (1 : ℤ), Subgroup.zpow_mem_zpowers _ 1⟩
      from Subtype.ext (by simp [hnnA])]
    exact zpowEquivSubgroup_symm_apply (Multiplicative.ofAdd (2 : ℤ)) orderOf_two 1
  have hphi : (phi hnnA : Base) = Multiplicative.ofAdd (3 : ℤ) := by
    change ((zpowEquivSubgroup (Multiplicative.ofAdd (3 : ℤ)) orderOf_three)
      ((zpowEquivSubgroup (Multiplicative.ofAdd (2 : ℤ)) orderOf_two).symm hnnA) :
        Base) = Multiplicative.ofAdd (3 : ℤ)
    rw [h2]
    simp
  have hof : HNNExtension.of (hnnA : Base) = hnnGen ^ 2 := by
    rw [hnnGen_pow]
    rfl
  have hof3 : HNNExtension.of (Multiplicative.ofAdd (3 : ℤ)) = hnnGen ^ 3 := by
    rw [hnnGen_pow]
    rfl
  rw [hphi, hof3, hof] at h
  exact h.symm

/-- The BS(2,3) relator is trivial in the HNN model. -/
theorem hnn_relator :
    HNNExtension.t * hnnGen ^ 2 * HNNExtension.t⁻¹ * hnnGen ^ (-3 : ℤ) = 1 := by
  rw [hnn_conj]
  group

/-- The map from the presented BS(2,3) to the HNN model. -/
noncomputable def toHNN : BS23 →* HNN :=
  PresentedGroup.toGroup (f := fun i : Fin 2 =>
    if i = 0 then hnnGen else HNNExtension.t) (by
      intro r hr
      simp only [bs23Rels, Set.mem_singleton_iff] at hr
      subst r
      simpa [bs23Relator] using hnn_relator)


/-- The first BS(2,3) generator. -/
noncomputable def bs23A : BS23 :=
  bs23Map (FreeGroup.of 0)

/-- The second BS(2,3) generator. -/
noncomputable def bs23T : BS23 :=
  bs23Map (FreeGroup.of 1)

/-- The BS(2,3) relation in conjugation form. -/
theorem bs23_conj : bs23T * bs23A ^ 2 * bs23T⁻¹ = bs23A ^ 3 := by
  have h := AC.BS23Britton.bs23_relator_eq_one
  have h' : bs23T * bs23A ^ 2 * bs23T⁻¹ * bs23A ^ (-3 : ℤ) = 1 := by
    simpa [bs23Relator, bs23A, bs23T] using h
  calc
    bs23T * bs23A ^ 2 * bs23T⁻¹ =
        (bs23T * bs23A ^ 2 * bs23T⁻¹ * bs23A ^ (-3 : ℤ)) * bs23A ^ 3 := by
          group
    _ = 1 * bs23A ^ 3 := by rw [h']
    _ = bs23A ^ 3 := by group

/-- The relation for every integer power. -/
theorem bs23_conj_zpow (n : ℤ) :
    bs23T * bs23A ^ (2 * n) * bs23T⁻¹ = bs23A ^ (3 * n) := by
  have h := congrArg (fun x : BS23 => x ^ n) bs23_conj
  simpa [conj_zpow, zpow_mul] using h

/-- The HNN identification sends `(ofAdd 2)^n` to `(ofAdd 3)^n`. -/
@[simp] theorem phi_zpow (n : ℤ) :
    (phi ⟨(Multiplicative.ofAdd (2 : ℤ)) ^ n, by
      rw [A]
      exact Subgroup.zpow_mem_zpowers _ n⟩ : Base) =
      (Multiplicative.ofAdd (3 : ℤ)) ^ n := by
  change ((zpowEquivSubgroup (Multiplicative.ofAdd (3 : ℤ)) orderOf_three)
    ((zpowEquivSubgroup (Multiplicative.ofAdd (2 : ℤ)) orderOf_two).symm
      ⟨(Multiplicative.ofAdd (2 : ℤ)) ^ n, by
        exact Subgroup.zpow_mem_zpowers _ n⟩) : Base) =
    (Multiplicative.ofAdd (3 : ℤ)) ^ n
  rw [zpowEquivSubgroup_symm_apply]
  simp

/-- The map from the HNN model back to the presented BS(2,3). -/
noncomputable def ofHNN : HNN →* BS23 :=
  HNNExtension.lift (zpowersHom BS23 bs23A) bs23T (by
    intro a
    rcases a with ⟨a, ha⟩
    change a ∈ Subgroup.zpowers (Multiplicative.ofAdd (2 : ℤ)) at ha
    rcases (Subgroup.mem_zpowers_iff).mp ha with ⟨n, rfl⟩
    rw [phi_zpow]
    simp only [zpowersHom_apply]
    calc
      bs23T * bs23A ^ (n * 2) =
          (bs23T * bs23A ^ (2 * n) * bs23T⁻¹) * bs23T := by
            rw [show n * 2 = 2 * n by ring]
            group
      _ = bs23A ^ (3 * n) * bs23T := by rw [bs23_conj_zpow n]
      _ = bs23A ^ (n * 3) * bs23T := by
            rw [show 3 * n = n * 3 by ring])

/-- The HNN map is a left inverse of the presented-group map. -/
theorem ofHNN_toHNN : ofHNN.comp toHNN = MonoidHom.id BS23 := by
  apply PresentedGroup.ext
  intro i
  fin_cases i
  · simp [toHNN, ofHNN, hnnGen, bs23A,
      PresentedGroup.toGroup.of, HNNExtension.lift_of, zpowersHom_apply]
    rfl
  · simp [toHNN, ofHNN, bs23T,
      PresentedGroup.toGroup.of, HNNExtension.lift_t]
    rfl

/-- The presented-group map to the HNN model is injective. -/
theorem toHNN_injective : Function.Injective toHNN := by
  have hleft : ∀ z : BS23, ofHNN (toHNN z) = z := by
    intro z
    have h := congrArg (fun f : BS23 →* BS23 => f z) ofHNN_toHNN
    simpa using h
  intro x y hxy
  calc
    x = ofHNN (toHNN x) := (hleft x).symm
    _ = ofHNN (toHNN y) := congrArg ofHNN hxy
    _ = y := hleft y

end BS23HNN
end AC

