import AcEuclid
import Mathlib.GroupTheory.FreeGroup.Reduce

/-!
# AcTailDefs — the definition closure of the multiplier core

This module supplies the definitions that the Magnus statement layer reads:
`AC.Tail.totalTail`, `AC.Tail.MultiplierCore`, and `AC.Tail.MultiplierCorePlus`,
together with the tail and the predicates that compose them.  It carries no
theorem and no proof, and it declares no descent statement.

The abelian-terminal predicate is read from `AC.Euclid`, where the compiled
corpus declares it, so the name has one declaration.  `ConjProd`, the coset
section, the tail, and the core predicates are copied from the session source
`AcTail.lean` without any proof. The session source is this project's own material
and carries this repository's Apache 2.0 licence.
-/

set_option autoImplicit false

namespace AC
namespace Tail

open AC.Invariant

/-- The fixed coset section `x ^ a * y ^ b` of the abelianisation `ℤ²`. -/
noncomputable def cosetSection (a b : ℤ) : Word 2 :=
  (FreeGroup.of (0 : Fin 2)) ^ a * (FreeGroup.of (1 : Fin 2)) ^ b

/-- The commutator tail of `w`: the word obtained by removing the section of
its exponent vector.  Its exponent vector is zero, so it lies in the
commutator subgroup. -/
noncomputable def tail (w : Word 2) : Word 2 :=
  w * (cosetSection (expVec w 0) (expVec w 1))⁻¹

/-- The length of the reduced commutator tail. -/
noncomputable def tailLength (w : Word 2) : ℕ :=
  (tail w).toWord.length

/-- The total commutator-tail length of a rank-two state. -/
noncomputable def totalTail (R : Relators 2) : ℕ :=
  tailLength (R 0) + tailLength (R 1)

/-- The submonoid generated by the conjugates of `B` and `B⁻¹`. -/
inductive ConjProd (B : Word 2) : Word 2 → Prop where
  | one : ConjProd B 1
  | ofConj (w : Word 2) : ConjProd B (w * B * w⁻¹)
  | ofConjInv (w : Word 2) : ConjProd B (w * B⁻¹ * w⁻¹)
  | mul {u v : Word 2} : ConjProd B u → ConjProd B v → ConjProd B (u * v)

/-- The residual multiplier core: neither the normal closure of a single
relator nor the normal closure of the product of the two relators lowers the
total tail. -/
def MultiplierCore (S : Relators 2) : Prop :=
  Euclid.IsAbelianTerminal S ∧ PresentsTrivialGroup S ∧ 0 < totalTail S ∧
    (∀ (i j : Fin 2), i ≠ j → ∀ u : Word 2, expVec u = 0 → ConjProd (S j) u →
      tailLength (S i) ≤ (tail (u * S i)).toWord.length) ∧
    (∀ (i j : Fin 2), i ≠ j → ∀ u : Word 2, expVec u = 0 →
      ConjProd (S j * S i) u →
      totalTail S ≤ (u * tail (S i)).toWord.length + tailLength (S j * u⁻¹))

/-- No inversion of a relator lowers the total tail. -/
def InvCore (S : Relators 2) : Prop :=
  ∀ i : Fin 2, totalTail S ≤ totalTail (Function.update S i ((S i)⁻¹))

/-- No conjugation of a relator lowers the total tail. -/
def ConjCore (S : Relators 2) : Prop :=
  ∀ (i : Fin 2) (w : Word 2),
    totalTail S ≤ totalTail (Function.update S i (w * S i * w⁻¹))

/-- No right multiplication by a conjugate product lowers the total tail. -/
def RightCore (S : Relators 2) : Prop :=
  ∀ (i j : Fin 2), i ≠ j → ∀ v : Word 2, expVec v = 0 → ConjProd (S j) v →
    totalTail S ≤ totalTail (Function.update S i (S i * v))

/-- No two-sided multiplier lowers the total tail. -/
def TwoSidedCore (S : Relators 2) : Prop :=
  ∀ (i j : Fin 2), i ≠ j → ∀ u v : Word 2, expVec u = 0 → expVec v = 0 →
    ConjProd (S j) u → ConjProd (S j) v →
    totalTail S ≤ totalTail (Function.update S i (u * S i * v))

/-- `MultiplierCorePlus` conjoins the multiplier core with the four move
families that `MultiplierCore` does not constrain. -/
def MultiplierCorePlus (S : Relators 2) : Prop :=
  MultiplierCore S ∧ InvCore S ∧ ConjCore S ∧ RightCore S ∧ TwoSidedCore S

end Tail
end AC
