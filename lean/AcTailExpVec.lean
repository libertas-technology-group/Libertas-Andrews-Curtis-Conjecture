module

public import AcTailDefs

@[expose] public section

/-!
# AcTailExpVec — the exponent vector of a conjugate product

`ConjProd B u` is the submonoid of `Word 2` generated by the conjugates of `B`
and `B⁻¹`.  The exponent-vector map `expVec` sends every such `u` onto the line
spanned by `expVec B`: the abelianisation of a conjugate product is an integral
multiple of the abelianisation of `B`.  The second theorem records the
consequence the multiplier-core argument reads: a conjugate product of a word
with zero exponent vector has zero exponent vector.

Declarations that carry no `sorry`: `expVec_conjProd_eq_zmul`,
`expVec_eq_zero_of_conjProd`.
-/

set_option autoImplicit false

namespace AC
namespace Tail

open AC.Invariant

/-- The exponent vector of a conjugate product of `B` is an integral multiple
of the exponent vector of `B`. -/
theorem expVec_conjProd_eq_zmul {B u : Word 2} (h : ConjProd B u) :
    ∃ k : ℤ, expVec u = k • expVec B := by
  induction h with
  | one => exact ⟨0, by simp⟩
  | ofConj w => exact ⟨1, by simp [expVec_conj]⟩
  | ofConjInv w =>
      refine ⟨-1, ?_⟩
      rw [expVec_conj, expVec_inv]
      ext i
      simp
  | mul h₁ h₂ ih₁ ih₂ =>
      obtain ⟨k₁, hk₁⟩ := ih₁
      obtain ⟨k₂, hk₂⟩ := ih₂
      refine ⟨k₁ + k₂, ?_⟩
      rw [expVec_mul, hk₁, hk₂]
      ext i
      simp [add_mul]

/-- A conjugate product of a word whose exponent vector is zero has zero
exponent vector. -/
theorem expVec_eq_zero_of_conjProd {B u : Word 2} (hB : expVec B = 0)
    (h : ConjProd B u) : expVec u = 0 := by
  obtain ⟨k, hk⟩ := expVec_conjProd_eq_zmul h
  rw [hk]
  simp [hB]

end Tail
end AC
