module

public import BranchC3

@[expose] public section

/-!
# The quotient index test

The second counterproof route at rank two.  An Andrews–Curtis path over the free
group `F₂` maps under `pslMap` to a path of group AC moves on pairs in
`PSL(2,ℤ) ≅ C₂ * C₃`.  A group AC move preserves the normal closure of the
pair (`GroupACStep.normalClosure_eq`), hence preserves the index of that normal
closure in `PSL`.  The standard pair `(a, b)` generates `PSL`, so its normal
closure has index one.  A presentation whose image pair has normal-closure index
different from one therefore admits no Andrews–Curtis path to the standard pair.

The invariant is `BranchC3.pairNormalClosure`, the normal closure of the two
components: the subgroup generated by the pair together with all its conjugates.
`GroupACStep.normalClosure_eq` is the preservation lemma on which the first
result below rests.

The hypothesis of `psl_index_separates` is the inequality `index ≠ 1`; a pair
whose normal closure is the whole group satisfies no such hypothesis, so the
lemma yields nothing there.

## Main results

* `groupACStep_index_eq` : one group AC move preserves the index.
* `groupACReachable_index_eq` : a finite group AC path preserves the index.
* `psl_index_separates` : a normal-closure index different from one refutes
  reachability to the standard pair.

## Status

No `sorry`, no `admit`, no user `axiom`, no `native_decide`.  Single-file check
from `lean/`: `lake env lean AcQuotient.lean`.
-/

set_option autoImplicit false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedSimpArgs false

namespace AC
namespace Quotient

open BranchC3

/-! ## 1. The index invariant -/

/-- One group AC move preserves the index of the normal closure of the pair.
The three moves replace a component by its inverse, by its product with the
other component, or by a conjugate.  `GroupACStep.normalClosure_eq` shows the
normal closure is unchanged, and the index is a function of the subgroup. -/
theorem groupACStep_index_eq {G : Type*} [Group G] {g h : G × G}
    (hstep : GroupACStep G g h) :
    (pairNormalClosure g).index = (pairNormalClosure h).index := by
  rw [GroupACStep.normalClosure_eq hstep]

/-- A finite group AC path preserves the index of the normal closure of the
pair.  The proof follows the reflexive–transitive closure one move at a time. -/
theorem groupACReachable_index_eq {G : Type*} [Group G] {g h : G × G}
    (hpath : GroupACReachable G g h) :
    (pairNormalClosure g).index = (pairNormalClosure h).index := by
  induction hpath with
  | refl => rfl
  | tail _ hstep ih => exact ih.trans (groupACStep_index_eq hstep)

/-! ## 2. The standard pair generates `PSL` -/

/-- Every element of `PSL` lies in the subgroup generated by `a` and `b`.
`PSL` is the free product of the order-two factor and the order-three factor.
Each factor is cyclic, generated by `a` and by `b` respectively, and
`Monoid.CoprodI.induction_on` decomposes an arbitrary element into a product of
factor elements. -/
theorem closure_a_b_eq_top :
    Subgroup.closure ({a, b} : Set PSL) = ⊤ := by
  rw [eq_top_iff]
  intro x _
  refine Monoid.CoprodI.induction_on x (Subgroup.one_mem _) ?_ ?_
  · intro i m
    cases i with
    | true =>
        rcases (show m = 1 ∨ m = Multiplicative.ofAdd (1 : ZMod 2) from by decide +revert) with
          rfl | rfl
        · simp
        · exact Subgroup.subset_closure (by
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
            exact Or.inl rfl)
    | false =>
        rcases (show m = 1 ∨ m = Multiplicative.ofAdd (1 : ZMod 3) ∨
            m = Multiplicative.ofAdd (1 : ZMod 3) * Multiplicative.ofAdd (1 : ZMod 3)
            from by decide +revert) with rfl | rfl | rfl
        · simp
        · exact Subgroup.subset_closure (by
            simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
            exact Or.inr rfl)
        · have hb : b ∈ Subgroup.closure ({a, b} : Set PSL) := Subgroup.subset_closure (by simp)
          have hsplit : Monoid.CoprodI.of (M := pslFactor) (i := false)
              (Multiplicative.ofAdd (1 : ZMod 3) * Multiplicative.ofAdd (1 : ZMod 3))
              = Monoid.CoprodI.of (M := pslFactor) (i := false) (Multiplicative.ofAdd (1 : ZMod 3))
                * Monoid.CoprodI.of (M := pslFactor) (i := false) (Multiplicative.ofAdd (1 : ZMod 3)) :=
            map_mul _ _ _
          rw [hsplit]
          exact Subgroup.mul_mem _ hb hb
  · intro y z hy hz
    exact Subgroup.mul_mem _ hy hz

/-- The normal closure of the standard pair is the whole group.  Its index is
therefore one.  The normal closure contains the subgroup closure, which is the
whole group by `closure_a_b_eq_top`. -/
@[simp]
theorem pairNormalClosure_standardPSL : pairNormalClosure standardPSL = ⊤ := by
  have h : Subgroup.closure ({a, b} : Set PSL) ≤ Subgroup.normalClosure ({a, b} : Set PSL) :=
    Subgroup.closure_le_normalClosure
  rw [closure_a_b_eq_top] at h
  simp only [pairNormalClosure, standardPSL]
  exact eq_top_iff.mpr h

/-! ## 3. The separator -/

/-- A normal-closure index different from one refutes reachability to the
standard pair.  A group AC path would force the two indices to agree by
`groupACReachable_index_eq`, while the standard pair has index one by
`pairNormalClosure_standardPSL`. -/
theorem psl_index_separates {P : Relators 2}
    (h : (pairNormalClosure (tuplePSL P)).index ≠ 1) :
    ¬ Reachable P (standard 2) := by
  intro hpath
  have hp : GroupACReachable PSL (tuplePSL P) standardPSL := by
    simpa [tuplePSL_standard] using reachable_psl hpath
  have hidx := groupACReachable_index_eq hp
  have htop : (⊤ : Subgroup PSL).index = 1 := Subgroup.index_eq_one.mpr rfl
  rw [pairNormalClosure_standardPSL, htop] at hidx
  exact h hidx

end Quotient
end AC
